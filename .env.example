# Copy to .env and adjust. All values below are the defaults used when a variable is unset. No secrets here.

# Chat and embedding provider: ollama (OpenAI-compatible endpoint) or fake (deterministic, for tests and CI).
CHAT_PROVIDER=ollama
EMBED_PROVIDER=ollama

# OpenAI-compatible endpoint of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Chat and judge models per profile, see config/models.json: default (32 GB) or light (16 GB).
MODEL_PROFILE=default

# Embedding model, a key of "embeddings" in config/models.json: nomic-embed-text or mxbai-embed-large.
EMBED_MODEL=nomic-embed-text
