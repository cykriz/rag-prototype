# Copy to .env and adjust. All values below are the defaults used when a variable is unset. No secrets here.

# Chat and embedding provider: ollama (OpenAI-compatible endpoint) or fake (deterministic, for tests and CI).
CHAT_PROVIDER=ollama
EMBED_PROVIDER=ollama

# OpenAI-compatible endpoint of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Chat and judge models per profile, see config/models.json: default (32 GB) or light (16 GB).
MODEL_PROFILE=default

# Embedding model, a key of "embeddings" in config/models.json: nomic-embed-text or mxbai-embed-large.
EMBED_MODEL=nomic-embed-text

# Required, no default: the Postgres database from docker-compose.yml. Database scripts fail fast when it is unset.
# Integration tests use "<name>_test" on the same server (created on first run), never this database itself.
DATABASE_URL=postgres://rag:rag@localhost:5433/rag

# Pinned commit of oven-sh/bun (main, 2026-11-14, after tag bun-v1.4.4) whose docs/ scripts/fetch-corpus.sh downloads into corpus/.
# Public commit SHA, not a secret. Change it only together with a corpus re-ingest and a re-check of the
# license note in README.md. bun run ingest requires it and stores it as documents.corpus_version.
CORPUS_SHA=b6f9cfa0e820b025916e50651b377ee1dff4d173
